---
const onlyDentists = Astro.props.onlyDentists || false;
---

<section class="ftco-section">
  <div class="container">
    <!-- Our Dentists Section -->
    <div class="row justify-content-center mb-5 pb-3">
      <div class="col-md-7 heading-section ftco-animate text-center">
        <h2 class="mb-4">Doctors</h2>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6 col-lg-4 ftco-animate">
        <div class="staff">
          <div class="img-wrap d-flex align-items-stretch">
            <div
              class="img align-self-stretch"
              style="background-image: url(images/dentists/Dustin.jpg);"
            >
            </div>
          </div>
          <div class="text pt-3 text-center">
            <h3>Meet Dr. Dustin Michel</h3>
            <span class="position mb-2">Dentist</span>
            <div class="faded">
              <p>
                Born in Cardston and raised in Raymond, Alberta, Dr. Michel earned his Doctor of Dental Surgery degree at the University of Alberta in Edmonton. He and his wife, Leslie, have loved raising their eight children in Cardston and enjoy being an active part of the community. Dr. Michel is known for his dedication to patient care and his commitment to going the extra mile. He even calls each of his patients personally after work on the day of treatment to ensure they are comfortable and to answer any questions that they may have! His approach is thoughtful, thorough, and always centered on helping patients feel at ease.
              </p>
              <p>
                Whether it&#39;s routine care or more complex treatment, Dr. Michel&#39;s goal is to provide excellent dentistry with genuine care for each patient&#39;s well-being.
              </p>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-lg-4 ftco-animate">
        <div class="staff">
          <div class="img-wrap d-flex align-items-stretch">
            <div
              class="img align-self-stretch"
              style="background-image: url(images/dentists/Armes.jpg);"
            >
            </div>
          </div>
          <div class="text pt-3 text-center">
            <h3>Meet Dr. Armes Perrett</h3>
            <span class="position mb-2">Dentist</span>
            <div class="faded">
              <p>
                Born and raised in Mountain View, Alberta, Dr. Perrett now calls Cardston home with his wife, Becky, and their active family. When he&#39;s not in the office, you&#39;ll often find him cheering or helping out at his children&#39;s sporting events.
              </p>
              <p>
                Dr. Perrett earned his Doctor of Dental Medicine degree from the University of Saskatchewan and is committed to helping patients achieve healthy, confident smiles. In the office, he combines skill and compassion to provide quality dental care in a comfortable setting. Patients know they can expect thoughtful treatment—along with the occasional lighthearted joke.
              </p>
              <p>
                Whether you&#39;re visiting for a routine checkup or more advanced care, Dr. Perrett&#39;s goal is simple: to make your experience positive and to help you leave with a smile.
              </p>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-lg-4 ftco-animate">
        <div class="staff">
          <div class="img-wrap d-flex align-items-stretch">
            <div
              class="img align-self-stretch"
              style="background-image: url(images/dentists/Michael.jpg);"
            >
            </div>
          </div>
          <div class="text pt-3 text-center">
            <h3>Meet Dr. Michael French</h3>
            <span class="position mb-2">Orthodontist</span>
            <div class="faded">
              <p>
                Born and raised in Cardston, Dr. French went all the way to Indiana for dental school, added a Master&#39;s thesis and two years of orthodontic specialty training, and came back as a registered Specialist in Orthodontics. (Just a fancy way of saying he&#39;s really good at straightening smiles.)
              </p>
              <p>
                When he&#39;s not lining up teeth, he&#39;s shooting hoops, golfing, camping, or chasing adventures with his wife Shantel and their eight children. Around the office, he&#39;s known for making patients feel at ease—he loves connecting with patients, swapping stories, and making the journey to a new smile as enjoyable as possible.
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    {!onlyDentists && (
      <>
        <!-- Our Staff Section -->
        <div class="row justify-content-center mb-5 pb-3 mt-5">
          <div class="col-md-7 heading-section ftco-animate text-center">
            <h2 class="mb-4">Staff</h2>
          </div>
        </div>
        <div class="row staff-row">
          <!-- Dental Assistants -->
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Paula Brown</h3>
                <span class="position mb-2">Dental Assistant</span>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Randee Wilde</h3>
                <span class="position mb-2">Dental Assistant</span>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Melissa MacKenzie</h3>
                <span class="position mb-2">Dental Assistant</span>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Sheila Lowry</h3>
                <span class="position mb-2">Dental Assistant</span>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Lyndee Wynder</h3>
                <span class="position mb-2">Dental Assistant</span>
              </div>
            </div>
          </div>

          <!-- Dental Hygienists -->
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Heber Keeler</h3>
                <span class="position mb-2">Dental Hygienist</span>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Gabby Stone</h3>
                <span class="position mb-2">Dental Hygienist</span>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Shelby West</h3>
                <span class="position mb-2">Dental Hygienist</span>
              </div>
            </div>
          </div>

          <!-- Coordinators -->
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Carrie Little</h3>
                <span class="position mb-2">Treatment / Financial / Scheduling Coordinator</span>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Shannon Bridge</h3>
                <span class="position mb-2">Treatment / Financial / Scheduling Coordinator</span>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Nicki Thompson</h3>
                <span class="position mb-2">Treatment / Financial / Scheduling Coordinator</span>
              </div>
            </div>
          </div>
        </div>
      </>
    )}
  </div>
</section>

<style>
  .staff {
    border-radius: 1em;
  }
  .staff div.text {
    padding: 1em;
  }

    .staff-no-image {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    border: 1px solid #dee2e6;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    min-height: 140px;
    display: flex;
    align-items: center;
    height: 100%;
  }

  .staff-no-image:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
  }

  .staff-no-image h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .staff-no-image .position {
    color: #6c757d;
    font-weight: 500;
    font-size: 0.85rem;
    line-height: 1.4;
    display: block;
    word-wrap: break-word;
    hyphens: auto;
  }

  .staff-no-image .text {
    width: 100%;
    padding: 1.5rem 0.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .staff-row .col-md-6,
  .staff-row .col-lg-3 {
    margin-bottom: 2rem;
  }
</style>
