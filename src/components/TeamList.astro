---
const onlyDentists = Astro.props.onlyDentists || false;
---

<section class="ftco-section">
  <div class="container">
    <!-- Our Dentists Section -->
    <div class="row justify-content-center mb-5 pb-3">
      <div class="col-md-7 heading-section ftco-animate text-center">
        <h2 class="mb-4">Doctors</h2>
      </div>
    </div>
    <div class="row">
      <div class="col-md-6 col-lg-4 ftco-animate">
        <div class="staff">
          <div class="img-wrap d-flex align-items-stretch">
            <div
              class="img align-self-stretch"
              style="background-image: url(images/dentists/Dustin.jpg);"
            >
            </div>
          </div>
          <div class="text pt-3 text-center">
            <h3>Dr. Dustin Michel</h3>
            <span class="position mb-2">Dentist</span>
            <div class="faded">
              <p>
                Prolonged exposure to our office may lead to a healthy smile, but no guarantees on the jokes. Come for the fillings, stay for the dad jokes!
              </p>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-lg-4 ftco-animate">
        <div class="staff">
          <div class="img-wrap d-flex align-items-stretch">
            <div
              class="img align-self-stretch"
              style="background-image: url(images/dentists/Armes.jpg);"
            >
            </div>
          </div>
          <div class="text pt-3 text-center">
            <h3>Dr. Armes Perrett</h3>
            <span class="position mb-2">Dentist</span>
            <div class="faded">
              <p>
                By night, a superhero fighting tooth decay and villainous plaque. Our office is equipped with the latest in dental tech and a strong Wi-Fi signal. Appointments available. No cape required.
              </p>
            </div>
          </div>
        </div>
      </div>
      <div class="col-md-6 col-lg-4 ftco-animate">
        <div class="staff">
          <div class="img-wrap d-flex align-items-stretch">
            <div
              class="img align-self-stretch"
              style="background-image: url(images/dentists/Michael.jpg);"
            >
            </div>
          </div>
          <div class="text pt-3 text-center">
            <h3>Dr. Michael French</h3>
            <span class="position mb-2">Orthodontist</span>
            <div class="faded">
              <p>
                When not fixing teeth, I'm probably trying to fix my golf swing or perfecting my cookie-baking skills. Book an appointment and let's get your smile (and my baking skills) on track!"
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>

    {!onlyDentists && (
      <>
        <!-- Our Staff Section -->
        <div class="row justify-content-center mb-5 pb-3 mt-5">
          <div class="col-md-7 heading-section ftco-animate text-center">
            <h2 class="mb-4">Staff</h2>
          </div>
        </div>
        <div class="row staff-row">
          <!-- Dental Assistants -->
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Paula Brown</h3>
                <span class="position mb-2">Dental Assistant</span>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Randee Wilde</h3>
                <span class="position mb-2">Dental Assistant</span>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Melissa MacKenzie</h3>
                <span class="position mb-2">Dental Assistant</span>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Sheila Lowry</h3>
                <span class="position mb-2">Dental Assistant</span>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Lyndee Wynder</h3>
                <span class="position mb-2">Dental Assistant</span>
              </div>
            </div>
          </div>

          <!-- Dental Hygienists -->
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Heber Keeler</h3>
                <span class="position mb-2">Dental Hygienist</span>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Gabby Stone</h3>
                <span class="position mb-2">Dental Hygienist</span>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Shelby West</h3>
                <span class="position mb-2">Dental Hygienist</span>
              </div>
            </div>
          </div>

          <!-- Coordinators -->
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Carrie Little</h3>
                <span class="position mb-2">Treatment / Financial / Scheduling Coordinator</span>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Shannon Bridge</h3>
                <span class="position mb-2">Treatment / Financial / Scheduling Coordinator</span>
              </div>
            </div>
          </div>
          <div class="col-md-6 col-lg-3 ftco-animate">
            <div class="staff staff-no-image">
              <div class="text pt-4 text-center">
                <h3>Nicki Thompson</h3>
                <span class="position mb-2">Treatment / Financial / Scheduling Coordinator</span>
              </div>
            </div>
          </div>
        </div>
      </>
    )}
  </div>
</section>

<style>
  .staff {
    border-radius: 1em;
  }
  .staff div.text {
    padding: 1em;
  }

    .staff-no-image {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
    border: 1px solid #dee2e6;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    transition: all 0.3s ease;
    min-height: 140px;
    display: flex;
    align-items: center;
    height: 100%;
  }

  .staff-no-image:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.15);
  }

  .staff-no-image h3 {
    font-size: 1.25rem;
    font-weight: 600;
    color: #2c3e50;
    margin-bottom: 0.5rem;
    line-height: 1.3;
  }

  .staff-no-image .position {
    color: #6c757d;
    font-weight: 500;
    font-size: 0.85rem;
    line-height: 1.4;
    display: block;
    word-wrap: break-word;
    hyphens: auto;
  }

  .staff-no-image .text {
    width: 100%;
    padding: 1.5rem 0.75rem;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .staff-row .col-md-6,
  .staff-row .col-lg-3 {
    margin-bottom: 2rem;
  }
</style>
