---
interface Props {
  title?: string;
}

const { title = "Your Family Dental Clinic" } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <title>All Smiles Dental & Orthodontics - {title}</title>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, shrink-to-fit=no"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css?family=Poppins:300,400,500,600,700&display=swap"
      rel="stylesheet"
    />
    <link
      href="https://fonts.googleapis.com/css2?family=Pacifico&display=swap"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="css/open-iconic-bootstrap.min.css" />
    <link rel="stylesheet" href="css/animate.css" />
    <link rel="stylesheet" href="css/owl.carousel.min.css" />
    <link rel="stylesheet" href="css/owl.theme.default.min.css" />
    <link rel="stylesheet" href="css/magnific-popup.css" />
    <link rel="stylesheet" href="css/aos.css" />
    <link rel="stylesheet" href="css/ionicons.min.css" />
    <link rel="stylesheet" href="css/bootstrap-datepicker.css" />
    <link rel="stylesheet" href="css/jquery.timepicker.css" />
    <link rel="stylesheet" href="css/flaticon.css" />
    <link rel="stylesheet" href="css/icomoon.css" />
    <link rel="stylesheet" href="css/style.css" />
  </head>
  <body>
    <slot />
  </body>
  <script is:inline src="js/jquery.min.js"></script>
  <script is:inline src="js/jquery-migrate-3.0.1.min.js"></script>
  <script is:inline src="js/popper.min.js"></script>
  <script is:inline src="js/bootstrap.min.js"></script>
  <script is:inline src="js/jquery.easing.1.3.js"></script>
  <script is:inline src="js/jquery.waypoints.min.js"></script>
  <script is:inline src="js/jquery.stellar.min.js"></script>
  <script is:inline src="js/owl.carousel.min.js"></script>
  <script is:inline src="js/jquery.magnific-popup.min.js"></script>
  <script is:inline src="js/aos.js"></script>
  <script is:inline src="js/jquery.animateNumber.min.js"></script>
  <script is:inline src="js/bootstrap-datepicker.js"></script>
  <script is:inline src="js/jquery.timepicker.min.js"></script>
  <script is:inline src="js/scrollax.min.js"></script>
  <script
    is:inline
    src="https://maps.googleapis.com/maps/api/js?key=AIzaSyBVWaKrjvy3MaE7SQ74_uJiULgl1JY0H2s&sensor=false"
  ></script>
  <script is:inline src="js/google-map.js"></script>
  <script is:inline src="js/main.js"></script>
  <script is:inline>
    // Prevent default scroll-to-top for placeholder links
    document.addEventListener("click", function (e) {
      const anchor = e.target.closest('a[href="#"]');
      if (anchor) {
        e.preventDefault();
      }
    });
  </script>
  <script is:inline>
    // Restore prior scroll position when returning from another app
    (function () {
      function saveScroll() {
        const lastScrollY = window.scrollY || window.pageYOffset || -1;
        try {
          sessionStorage.setItem("lastScrollY", String(lastScrollY));
        } catch (_) {}
      }

      document.addEventListener("visibilitychange", function () {
        if (document.visibilityState === "hidden") {
          saveScroll();
        }
        if (document.visibilityState === "visible") {
          const stored = -1;
          try {
            stored = parseInt(sessionStorage.getItem("lastScrollY") || "0", 10);
          } catch (_) {}
          if (stored > -1) {
            setTimeout(function () {
              // Only restore if we unexpectedly jumped upward
              if ((window.scrollY || window.pageYOffset || 0) < stored - 8) {
                window.scrollTo(0, stored);
              }
            }, 60);
          }
        }
      });

      window.addEventListener("blur", saveScroll);
      window.addEventListener("beforeunload", saveScroll);
    })();
  </script>
  <script
    is:inline
    async
    src="https://www.googletagmanager.com/gtag/js?id=G-9L39DZPVP2"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag() {
      dataLayer.push(arguments);
    }
    gtag("js", new Date());
    if (window.location.hostname === "cardstonsmiles.com") {
      gtag("config", "G-SMMX6WBWJL"); // production
    } else {
      gtag("config", "G-9L39DZPVP2"); // staging
    }
  </script>
</html>

<style is:global>
  html {
    scroll-behavior: smooth;
  }
  body {
    background-color: #f5f5f5 !important;
  }
</style>
