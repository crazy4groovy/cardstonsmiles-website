---
interface Props {
  title: string;
  breadcrumbs: {name: string; url?: string}[];
  backgroundImage: string;
}

const { title, breadcrumbs, backgroundImage } = Astro.props;
---

<section class="hero-wrap hero-wrap-2" style={`background-image: url('${backgroundImage}');`} data-stellar-background-ratio="0.5">
  <div class="overlay"></div>
  <div class="container">
    <div class="row no-gutters slider-text align-items-center justify-content-center">
      <div class="col-md-9 ftco-animate text-center">
        <h1 class="mb-2 bread">{title}</h1>
        <p class="breadcrumbs">
          {breadcrumbs.map((item, index) => (
            <>
              <span class="mr-2">
                {item.url ?
                  <a href={item.url}>{item.name} <i class="ion-ios-arrow-forward"></i></a> :
                  <>{item.name} {index < breadcrumbs.length - 1 && <i class="ion-ios-arrow-forward"></i>}</>
                }
              </span>
            </>
          ))}
        </p>
      </div>
    </div>
  </div>
</section>
