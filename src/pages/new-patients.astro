---
import CTAAppointment from "../components/CTAAppointment.astro";
import FAQ from "../components/FAQ.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Main from "../layouts/Main.astro";
import WhatToExpect from "../components/WhatToExpect.astro";

const faqs = [
  {
    question: "What should I bring to my first appointment?",
    answer:
      "Please bring your insurance card (if you have dental insurance), a list of current medications, and any previous dental records or X-rays if available. If you haven't completed our new patient forms online, please arrive 15 minutes early to fill them out.",
  },
  {
    question: "How long will my first visit take?",
    answer:
      "Your initial comprehensive exam typically takes 60-90 minutes. This includes time for paperwork, medical history review, X-rays, thorough examination, and discussion of treatment recommendations. We want to ensure we have adequate time to address all your concerns.",
  },
  {
    question: "Will my first visit be painful?",
    answer:
      "Your initial exam should not be painful. We perform a gentle, thorough examination of your teeth, gums, and mouth. If you have dental anxiety, please let us know in advance so we can discuss comfort options and take extra steps to ensure you feel relaxed.",
  },
  {
    question: "Do you accept my dental insurance?",
    answer:
      "We accept most major dental insurance plans and are in-network with many providers. Our team will verify your benefits before your appointment and explain your coverage.",
  },
  {
    question: "What if I haven't been to a dentist in years?",
    answer:
      "Don't worry – you're not alone! We see many patients who haven't had dental care in years, and we provide a judgment-free environment. We'll work with you to prioritize treatments based on your needs and comfort level, creating a manageable plan for restoring your oral health.",
  },
  {
    question: "Can I get a cleaning on my first visit?",
    answer:
      "In many cases, yes! If your oral health allows, we can often provide a professional cleaning during your first appointment. However, if we detect gum disease or other issues, we may recommend a specialized cleaning or treatment plan that requires a separate appointment.",
  },
  {
    question: "What happens if you find problems during my exam?",
    answer:
      "If we discover any dental issues, we'll explain our findings using easy-to-understand language and visual aids. We'll discuss all treatment options, prioritize care based on urgency, and provide transparent cost estimates. You'll never feel pressured – we believe in collaborative decision-making for your dental health.",
  },
];
---

<Main>
  <Header />

  <!-- <section class="hero-wrap hero-wrap-2" style="background-image: url('/images/bg_1.jpg');">
    <div class="overlay"></div>
    <div class="container">
      <div class="row no-gutters slider-text align-items-center justify-content-center">
        <div class="col-md-9 text-center ftco-animate">
          <h1 class="mb-2 bread">New Patients</h1>
          <p class="breadcrumbs"><span class="mr-2"><a href="/">Home <i class="ion-ios-arrow-forward"></i></a></span> <span>New Patients</span></p>
        </div>
      </div>
    </div>
  </section> -->

  <CTAAppointment />

  <WhatToExpect />

  <FAQ faqs={faqs} />

  <section class="ftco-section ftco-no-pt ftco-no-pb bg-light">
    <div class="container">
      <div class="row d-flex justify-content-center py-5">
        <div class="col-md-8 text-center heading-section ftco-animate">
          <h2 class="mb-4">Have Additional Questions?</h2>
          <p>
            We're here to make your transition to our practice as smooth as
            possible. Contact our friendly team for any additional questions or
            to schedule your first appointment.
          </p>
          <a href="/contact" class="btn btn-primary py-3 px-4 mt-3"
            >Contact Us</a
          >
        </div>
      </div>
    </div>
  </section>

  <Footer />
</Main>

<style>
  .welcome-banner {
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
  }
  .welcome-banner:hover {
    transform: translateY(-5px);
    box-shadow: 0 1rem 3rem rgba(0, 0, 0, 0.175) !important;
  }
  .card {
    transition:
      transform 0.3s ease,
      box-shadow 0.3s ease;
    height: 100%;
    border-radius: 0.5rem;
    overflow: hidden;
    border: none;
  }
  .card:hover {
    transform: translateY(-5px);
    box-shadow: 0 0.5rem 1rem rgba(0, 0, 0, 0.15) !important;
  }
</style>
